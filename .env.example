# counsel-rag 설정 — 복사해서 .env로 사용. 비밀값은 .env에만 (git 금지)
# 모든 항목은 src/counsel_rag/config.py의 Settings와 1:1 대응

COUNSEL_DATABASE_URL=postgresql://counsel:counsel@localhost:5433/counsel
COUNSEL_KNOWLEDGE_DIR=knowledge-sample
COUNSEL_CORPUS_DIR=corpus

# 어댑터: bgem3_local(실모델) | fake(개발·테스트용)
COUNSEL_EMBEDDER=bgem3_local
COUNSEL_EMBEDDER_MODEL=BAAI/bge-m3
COUNSEL_EMBEDDER_DEVICE=auto
COUNSEL_RERANKER=bge_local
COUNSEL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# 검색 파이프라인 (쉼표 구분, 순서대로 실행)
# 주의: rerank를 빼면 threshold가 RRF 점수(약 0.016~0.033 스케일)와 비교되므로
#       COUNSEL_INSUFFICIENT_THRESHOLD를 함께 낮춰야 한다 (기본 0.35는 rerank 점수 기준)
COUNSEL_SEARCH_STAGES=hybrid,rrf,rerank,threshold
COUNSEL_RETRIEVAL_TOP_N=20
COUNSEL_RERANK_TOP_K=5
COUNSEL_RRF_K=60
COUNSEL_INSUFFICIENT_THRESHOLD=0.35

# 접근 통제 (JSON 배열. 비어 있으면 인증 비활성 = 개발 모드)
COUNSEL_API_KEYS=[]
COUNSEL_RATE_LIMIT_PER_MINUTE=60

COUNSEL_CRISIS_PATTERNS_PATH=data/crisis_patterns.yaml

# 클라이언트 모델 안내 문구 (kb_stats/README에 노출)
COUNSEL_MODEL_GUIDE=권장 클라이언트 모델: 최소 4B급(gemma 등) — search/get_document/list_topics 중심. related_documents·복합 워크플로는 상위 모델 권장.
